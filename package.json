  "type": "module",
  "scripts": {
    "dev": "vite",
    "projects:thumbs": "node scripts/generate-project-thumbs.mjs",
    "prebuild": "node scripts/generate-project-thumbs.mjs",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --define:import.meta.dirname=__dirname --define:import.meta.url=__filename --outfile=server/index.bundle.cjs --external:pg-native",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:a11y": "node scripts/rm17-a11y-scan.mjs",
    "qa:viewport": "node scripts/rm5-viewport-scan.mjs",
    "qa:likeness": "node scripts/marvin-likeness-gate.mjs",
    "qa:all": "npm run qa:viewport && npm run qa:a11y",
    "audit:prod-surface": "node scripts/audit-prod-surface.mjs",
    "projects:extract": "tsx scripts/extract-project-images.ts",
    "projects:images": "node scripts/build-project-category-images.mjs",
    "projects:reorder": "node scripts/reorder-project-images.mjs",
    "preview": "vite preview",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "deploy": "./deploy.sh",
    "deploy:status": "ssh advo \"cat /opt/fourlinq/deployed-from.txt\"",
    "deploy:log": "ssh advo \"tail -50 /var/log/fourlinq-auto-deploy.log 2>/dev/null || echo (auto-deploy not enabled — see scripts/vps-auto-deploy.sh)\""
  },
