{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": [
    "server/**/*.ts",
    "packages/cms-rag/server/**/*.ts",
    "src/data/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
