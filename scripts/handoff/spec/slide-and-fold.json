{
  "id": "slide-and-fold",
  "motion": "bifold_accordion",
  "panel_count": 4,
  "layout": "4L",
  "fold_direction": "interior",
  "hinge_rule": "panel_1 = theta at jamb, each following panel = -2x parent (alternating ±theta)",
  "theta_max_deg": 87,
  "load_path": "top_track_carriers",
  "clip": { "name": "open", "frames": 28, "easing": "ease-in-out" },
  "finish": "white",
  "units": "meters",
  "origin": "geometric center of outer frame, +Y up, +Z interior",
  "default_size_mm": { "width": 3600, "height": 2400, "frame_depth": 152, "leaf_depth": 62 },
  "meshes": [
    "frame", "head_track_housing", "track", "head_gasket",
    "sill", "sill_body", "sill_guide_channel", "sill_nose", "sill_weep_1..4",
    "left_panel_1..4", "left_glass_1..4", "left_panel_n_bottom_rail", "left_panel_n_bead", "left_panel_n_gasket",
    "left_hinge_hw_0..3 (knuckle, leaf_1, leaf_2, collar_1..3)",
    "left_carrier_1", "left_carrier_lead", "left_shoe_1", "left_shoe_lead",
    "left_handle (backplate, bar, rosette, lever, lever_tip, flush_pull)"
  ],
  "materials": {
    "upvc_white": { "baseColor": "#f3f3f0", "roughness": 0.62, "metalness": 0 },
    "upvc_white_rebate": { "baseColor": "#e9e9e5", "roughness": 0.7, "metalness": 0 },
    "glass_clear": { "baseColor": "#cfe0e6", "roughness": 0.06, "metalness": 0.15, "transmission": 0.72 },
    "epdm_gasket_black": { "baseColor": "#17191b", "roughness": 0.95, "metalness": 0 },
    "hardware_matte_black": { "baseColor": "#1c1d1f", "roughness": 0.45, "metalness": 0.3 },
    "hinge_steel": { "baseColor": "#9fa5a9", "roughness": 0.38, "metalness": 0.35 }
  },
  "variants": {
    "layout": ["4L", "4R", "2-2"],
    "fold": ["in", "out"],
    "finish": ["white", "charcoal", "bronze", "woodgrain"]
  }
}
