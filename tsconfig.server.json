{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "preserve",
    // src/data is in `include` above, and some of those modules import each
    // other through the @/ alias. Without this the server project cannot
    // resolve them and reports phantom TS2307s.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "server/**/*.ts",
    "packages/cms-rag/server/**/*.ts",
    "src/data/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
