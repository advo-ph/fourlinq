{
  "git": {
    "productionBranch": "redesign-marvin2"
  },
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/index.php", "destination": "/", "statusCode": 301 },
    { "source": "/index.php/", "destination": "/", "statusCode": 301 },
    { "source": "/index.php/contact-us", "destination": "/brand#contact", "statusCode": 301 },
    { "source": "/index.php/contact-us/", "destination": "/brand#contact", "statusCode": 301 },
    { "source": "/index.php/about-us", "destination": "/brand", "statusCode": 301 },
    { "source": "/index.php/about-us/", "destination": "/brand", "statusCode": 301 },
    { "source": "/index.php/our-products", "destination": "/products", "statusCode": 301 },
    { "source": "/index.php/our-products/", "destination": "/products", "statusCode": 301 },
    { "source": "/index.php/products", "destination": "/products", "statusCode": 301 },
    { "source": "/index.php/products/", "destination": "/products", "statusCode": 301 },
    { "source": "/index.php/why-upvc", "destination": "/why-upvc", "statusCode": 301 },
    { "source": "/index.php/why-upvc/", "destination": "/why-upvc", "statusCode": 301 },
    { "source": "/index.php/showrooms", "destination": "/brand#showrooms", "statusCode": 301 },
    { "source": "/index.php/showrooms/", "destination": "/brand#showrooms", "statusCode": 301 },
    { "source": "/index.php/locations", "destination": "/brand#showrooms", "statusCode": 301 },
    { "source": "/index.php/locations/", "destination": "/brand#showrooms", "statusCode": 301 },
    { "source": "/contact-us", "destination": "/brand#contact", "statusCode": 301 },
    { "source": "/contact-us/", "destination": "/brand#contact", "statusCode": 301 },
    { "source": "/about-us", "destination": "/brand", "statusCode": 301 },
    { "source": "/about-us/", "destination": "/brand", "statusCode": 301 },
    { "source": "/our-products", "destination": "/products", "statusCode": 301 },
    { "source": "/our-products/", "destination": "/products", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
